<module name="Gameplay">

<enum name="Quality">
	<var name="None" alias="空" value="0" />
	<var name="Common" alias="普通" value="1" />
	<var name="Rare" alias="稀有" value="2" />
	<var name="Premium" alias="精品" value="3" />
	<var name="Epic" alias="史诗" value="4" />
	<var name="Peerless" alias="绝世" value="5" />
	<var name="Legendary" alias="传说" value="6" />
	<var name="Mythic" alias="神话" value="7" />

</enum>

<bean name="TagData">
	<var name="id" type="int" alias="编号"/>
	<var name="pid" type="int" alias="父编号"/>
	<var name="name" type="string" alias="名字"/>
	<var name="desc" type="string" alias="描述"/>
	<var name="icon" type="string" alias="图标"/>
</bean>

<table name="TbTagData" value="TagData" input="data@gameplay/tag.xlsx"/>

<bean name="RoleData">
	<var name="id" type="int" alias="编号"/>
	<var name="name" type="string" alias="名字"/>
	<var name="desc" type="string" alias="描述"/>
	<var name="icon" type="string" alias="图标"/>
	<var name="collider" type="int" alias="碰撞盒"/>
	<var name="model_id" type="int" alias="模型编号"/>
	<var name="hp" type="int" alias="生命"/>
	<var name="atk" type="int" alias="攻击"/>
	<var name="def" type="int" alias="防御"/>
	<var name="spd" type="int" alias="速度"/>
	<var name="crit" type="int" alias="暴击"/>
	<var name="luck" type="int" alias="幸运"/>
</bean>

<table name="TbRoleData" value="RoleData" input="data@gameplay/role.xlsx"/>

<bean name="RoleModel">
	<var name="id" type="int" alias="编号"/>
	<var name="model" type="string" alias="模型"/>
	<var name="animation" type="string" alias="动画"/>
</bean>

<table name="TbRoleModel" value="RoleModel" input="model@gameplay/role.xlsx"/>

<bean name="RoleSkill">
	<var name="id" type="int" alias="编号"/>
	<var name="skills" type="(array#sep=,),int" alias="技能组"/>
</bean>

<table name="TbRoleSkill" value="RoleSkill" input="skill@gameplay/role.xlsx"/>

<enum name="RoleAttr">
	<var name="None" 	alias="空" 			value="0" />
	<var name="Hp" 		alias="血量" 		value="1" />
	<var name="Mp" 		alias="蓝量" 		value="2" />
	<var name="Atk" 	alias="攻击" 		value="3" />
	<var name="Def" 	alias="防御" 		value="4" />
	<var name="Spd" 	alias="速度" 		value="5" />
</enum>

<bean name="TimelineData">
	<var name="id" type="int" alias="编号"/>
	<var name="name" type="string" alias="名字"/>
	<var name="desc" type="string" alias="描述"/>
	<var name="icon" type="string" alias="图标"/>
	<var name="max_time" type="float" alias="最大时间"/>
	<var name="nodes" type="array,TimelineNode#sep=," alias="节点"/>
	<var name="go_to" type="TimelineGoTo?#sep=," alias="循环"/>
</bean>

<table name="TbTimelineData" value="TimelineData" input="gameplay/timeline.xlsx"/>

<bean name="TimelineNode">
	<var name="Time" type="float"/>
	<var name="Event" type="TimelineEvent"/>
</bean>

<bean name="TimelineEvent">
	<bean name="PrintEvent" alias="打印">
		<var name="Type" type="byte" alias="级别"/>
		<var name="Print" type="string" alias="日志打印"/>
	</bean>
	<bean name="AnimationEvent" alias="动画">
		<var name="Name"    		type="string" alias="动画名称"/>
		<var name="Loop"    		type="bool"   alias="动画循环"/>
		<var name="Speed"   		type="float"  alias="动画速度"/>
		<var name="CanMove"    		type="bool"   alias="锁住移动"/>
		<var name="ApplyMotion"  	type="bool"   alias="动画位移"/>
	</bean>
</bean>

<bean name="TimelineGoTo">
	<var name="From" type="float"/>
	<var name="To" type="float"/>
</bean>

<bean name="SkillData">
	<var name="id" type="int" alias="编号"/>
	<var name="name" type="string" alias="名字"/>
	<var name="desc" type="string" alias="描述"/>
	<var name="icon" type="string" alias="图标"/>
	<var name="cond" type="SkillCond?" alias="条件"/>
	<var name="cost" type="SkillCost?" alias="消耗"/>
	<var name="cooldown" type="float" alias="冷却"/>
	<var name="timeline" type="int" alias="时间轴"/>
</bean>

<table name="TbSkillData" value="SkillData" input="gameplay/skill.xlsx"/>

<bean name="SkillCond">
	<bean name="RoleResourceCond">
		<var name="Fixed" type="(map#sep=,),RoleAttr,int"/>
		<var name="Percent" type="(map#sep=,),RoleAttr,int"/>
	</bean>
</bean>

<bean name="SkillCost">
	<bean name="RoleResourceCost">
		<var name="Fixed" type="(map#sep=,),RoleAttr,int"/>
		<var name="Percent" type="(map#sep=,),RoleAttr,int"/>
	</bean>
</bean>

<bean name="ColliderData">
	<var name="id" type="int" alias="编号"/>
	<var name="desc" type="string" alias="描述"/>
	<var name="type" type="int" alias="类型"/>
	<var name="offset" type="(array#sep=|),float" alias="偏移"/>
	<var name="shape_data" type="(array#sep=|),float" alias="几何数据"/>
</bean>

<table name="TbColliderData" value="ColliderData" input="gameplay/collider.xlsx"/>

<bean name="PayloadData">
	<var name="id" type="int" alias="编号"/>
	<var name="name" type="string" alias="名字"/>
	<var name="desc" type="string" alias="描述"/>
	<var name="damage" type="DamageData?" alias="伤害数据"/>
	<var name="visual" type="VisualData?" alias="表现数据"/>
	<var name="add_buff" type="AddBuffData?" alias="增减BUFF"/>
	<var name="extra_data" type="int?#ref=Gameplay.TbPayloadData" alias="命中链"/>
</bean>

<table name="TbPayloadData" value="PayloadData" input="gameplay/payload.xlsx"/>

<bean name="DamageData">
	<var name="type" type="DamageType" alias="伤害类型"/>
	<var name="damage" type="int" alias="基础伤害"/>
	<var name="attack_type" type="ScalingType" alias="进攻加成类型" comment="取施法者身上的哪个属性做加成"/>
	<var name="attack_rate" type="float" alias="进攻加成系数"/>
	<var name="defense_type" type="ScalingType" alias="防守加成类型" comment="取目标身上的哪个属性做加成"/>
	<var name="defense_rate" type="float" alias="防守加成系数"/>
	<var name="hit_count" type="int" alias="击中次数"/>
	<var name="can_crit" type="bool" alias="可暴击"/>
</bean>

<bean name="VisualData">
	<var name="hit_fx" type="string" alias="特效"/>
	<var name="hit_sound" type="string" alias="音效"/>
	<var name="hit_point" type="int" alias="次数"/>
</bean>

<bean name="AddBuffData">
	<var name="buff_id" type="int" alias="特效"/>
	<var name="buff_stack" type="int" alias="音效"/>
</bean>

<enum name="DamageType">
	<var name="Physical" alias="物理"/>
	<var name="Magical" alias="法术"/>
	<var name="True" alias="真实" comment="无视抗性"/>
</enum>

<enum name="ScalingType" comment="伤害加成来源属性，进攻/防守共用">
	<var name="None" alias="无"/>
	<var name="Atk" alias="攻击"/>
	<var name="MaxHp" alias="最大生命"/>
	<var name="CurHp" alias="当前生命"/>
	<var name="LostHp" alias="已损生命"/>
	<var name="MoveSpeed" alias="移动速度"/>
</enum>

<bean name="MoudleData">
	<var name="id" type="int" alias="编号"/>
	<var name="name" type="string" alias="名字"/>
	<var name="desc" type="string" alias="描述"/>
	<var name="icon" type="string" alias="图标"/>
	<var name="weight" type="int" alias="权重"/>
	<var name="quality" type="Gameplay.Quality" alias="品质"/>
	<var name="add_skill_id" type="int" alias="添加技能"/>
	<var name="remove_skill_id" type="int" alias="移除技能"/>
	<var name="require_module_ids" type="(array#sep=,),int" alias="前置模组"/>
	<var name="exclude_module_ids" type="(array#sep=,),int" alias="互斥模组"/>
	<var name="dispel_module_ids" type="(array#sep=,),int" alias="驱散模组"/>
</bean>
<table name="TbMoudleData" value="MoudleData" input="data@gameplay/moudle.xlsx"/>
</module>
