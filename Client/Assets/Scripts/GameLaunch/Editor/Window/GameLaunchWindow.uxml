<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Label tabindex="-1" text="框架工具" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-text-align: upper-center; -unity-font-style: bold; font-size: 40px;" />
    <ui:TextField picking-mode="Ignore" label="热更资源输出路径" name="BuildBundleOutputDir" password="false" value="filler text" readonly="false" keyboard-type="Default" is-delayed="false" hide-mobile-input="false" auto-correction="false" multiline="false" style="align-items: stretch; justify-content: space-between; align-self: auto; -unity-font-style: bold; flex-direction: row; -unity-text-align: upper-left; white-space: nowrap; text-overflow: clip; background-image: none; display: flex; visibility: visible; overflow: hidden; color: rgb(0, 0, 0); -unity-background-image-tint-color: rgb(255, 255, 255);" />
    <ui:TextField picking-mode="Ignore" label="整包资源输出路径" name="BuildBundleInOutDir" password="false" value="filler text" readonly="false" keyboard-type="Default" style="align-items: auto; justify-content: space-around; align-self: auto; -unity-font-style: bold; flex-direction: row; -unity-text-align: middle-left; white-space: nowrap; text-overflow: clip; background-image: none; width: auto;" />
    <ui:TextField picking-mode="Ignore" label="AotDll输出路径" name="AotDllOutputDir" password="false" value="filler text" readonly="false" keyboard-type="Default" style="align-items: stretch; justify-content: space-between; align-self: auto; -unity-font-style: bold; flex-direction: row; -unity-text-align: upper-left; white-space: nowrap; text-overflow: clip; background-image: none;" />
    <ui:TextField picking-mode="Ignore" label="HotDll输出路径" name="HotDllOutputDir" password="false" value="filler text" readonly="false" keyboard-type="Default" style="align-items: stretch; justify-content: space-between; align-self: auto; -unity-font-style: bold; flex-direction: row; -unity-text-align: upper-left; white-space: nowrap; text-overflow: clip; background-image: none;" />
    <ui:TextField picking-mode="Ignore" label="打包输出路径" name="BuildOutputDir" password="false" value="filler text" readonly="false" keyboard-type="Default" style="align-items: stretch; justify-content: space-between; align-self: auto; -unity-font-style: bold; flex-direction: row; -unity-text-align: upper-left; white-space: nowrap; text-overflow: clip; background-image: none;" />
    <ui:EnumField label="平台类型" type="UnityEditor.BuildTarget, UnityEditor.CoreModule" name="BuildTarget" value="StandaloneWindows64" style="-unity-font-style: bold;" />
    <ui:TextField picking-mode="Ignore" label="资源版本" value="filler text" name="BuildVersion" style="-unity-font-style: bold;" />
    <ui:Button text="编译DLL" parse-escape-sequences="true" display-tooltip-when-elided="true" name="CompileDll" style="-unity-text-align: middle-center; height: auto; -unity-font-style: bold; font-size: 30px; color: rgb(255, 255, 255); -unity-font: initial; width: auto; white-space: nowrap; text-overflow: ellipsis; display: flex;" />
    <ui:Button text="打包热更包" parse-escape-sequences="true" display-tooltip-when-elided="true" name="BuildOutPutBundle" style="-unity-text-align: middle-center; height: auto; -unity-font-style: bold; font-size: 30px; color: rgb(255, 255, 255); -unity-font: initial;" />
    <ui:Button text="打包整包" parse-escape-sequences="true" display-tooltip-when-elided="true" name="BuildInBundle" style="-unity-text-align: middle-center; height: auto; -unity-font-style: bold; font-size: 30px; color: rgb(255, 255, 255); -unity-font: initial;" />
    <ui:Button text="一键打桌面" parse-escape-sequences="true" display-tooltip-when-elided="true" name="BuildWindow" style="-unity-text-align: middle-center; height: auto; -unity-font-style: bold; font-size: 30px; color: rgb(255, 255, 255); -unity-font: initial;" />
    <ui:Button text="一键打安卓" parse-escape-sequences="true" display-tooltip-when-elided="true" name="BuildAndroid" style="-unity-text-align: middle-center; height: auto; -unity-font-style: bold; font-size: 30px; color: rgb(255, 255, 255); -unity-font: initial;" />
</ui:UXML>
